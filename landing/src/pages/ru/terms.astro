---
import Base from '../../layouts/Base.astro'
import LegalPage from '../../components/LegalPage.astro'
import { CONTENT } from '../../content.js'
import { LEGAL } from '../../legal.js'
import { breadcrumbs, organization } from '../../schema.js'

const copy = CONTENT.ru
const doc = LEGAL.ru.terms
const jsonld = [
  organization(Astro.site),
  breadcrumbs(Astro.site, 'ru', [
    { name: 'Groundline', path: '/ru' },
    { name: 'Условия', path: '/ru/terms' },
  ]),
]
---

<Base lang="ru" title={doc.title} description={doc.description} path="/ru/terms" jsonld={jsonld}>
  <LegalPage copy={copy} doc={doc} />
</Base>
