---
import BrandMark from './BrandMark.astro'
import { SITE } from '../content.js'

const { copy } = Astro.props
const home = copy.dir === '/ru' ? '/ru' : '/'
---

<header class="site-header">
  <a class="brand" href={home}>
    <BrandMark />
    Groundline
  </a>
  <nav class="site-nav" aria-label={copy.lang === 'ru' ? 'Разделы' : 'Sections'}>
    <a href="#how">{copy.nav.how}</a>
    <a href="#auth">{copy.nav.auth}</a>
    <a href="#numbers">{copy.nav.numbers}</a>
    <a href="#faq">{copy.nav.faq}</a>
    <a href={SITE.repoUrl} target="_blank" rel="noopener">{copy.nav.repo}</a>
    <a href={copy.otherLocale.href} lang={copy.otherLocale.code} hreflang={copy.otherLocale.code}>
      {copy.otherLocale.label}
    </a>
    <a class="btn btn-primary" href={SITE.appUrl}>{copy.nav.demo}</a>
  </nav>
</header>
